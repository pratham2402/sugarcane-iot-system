# Gateway Environment Variables
# Copy this file to .env and fill in the values

# Gateway
GATEWAY_ID=gateway-01
GATEWAY_LOG_LEVEL=INFO

# Cloud Backend
CLOUD_BASE_URL=http://localhost:8000
CLOUD_REQUEST_TIMEOUT=15

# Receiver Mode
# "lora" for production, "mock" for development
RECEIVER_TYPE=mock

# Security (future)
# GATEWAY_API_KEY=your-gateway-api-key-here
